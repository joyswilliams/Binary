Question: Write a Python function search_record(roll_no) to search for a specific student's details in student.dat using their Roll Number. If found, display their details; otherwise, display "Record Not Found".

Answer:

import pickle


def search_record(target_roll):
    found = False
    try:
        with open("student.dat", "rb") as file:
            while True:
                try:
                    record = pickle.load(file)
                    if record["Roll"] == target_roll:
                        print("\nRecord Found!")
                        print(f"Roll No : {record['Roll']}")
                        print(f"Name    : {record['Name']}")
                        print(f"Marks   : {record['Marks']}")
                        found = True
                        break
                except EOFError:
                    break

        if not found:
            print(f"\nRecord with Roll Number {target_roll} not found.")

    except FileNotFoundError:
        print("Error: 'student.dat' file does not exist.")


# Main Execution
search_roll = int(input("Enter Roll Number to search: "))
search_record(search_roll)
