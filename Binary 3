Question: Write a function update_marks(roll_no, new_marks) in Python to modify the marks of a student with a given Roll Number in the binary file student.dat.

Answer:

import pickle


def update_marks(target_roll, new_marks):
    records = []
    updated = False

    # Step 1: Read all records into memory
    try:
        with open("student.dat", "rb") as file:
            while True:
                try:
                    record = pickle.load(file)
                    # Modify if match found
                    if record["Roll"] == target_roll:
                        record["Marks"] = new_marks
                        updated = True
                    records.append(record)
                except EOFError:
                    break
    except FileNotFoundError:
        print("Error: 'student.dat' file does not exist.")
        return

    # Step 2: Overwrite the binary file with updated records
    if updated:
        with open("student.dat", "wb") as file:
            for rec in records:
                pickle.dump(rec, file)
        print(
            f"\nMarks updated successfully for Roll Number {target_roll}!"
        )
    else:
        print(f"\nRoll Number {target_roll} not found in records.")


# Main Execution
r_num = int(input("Enter Roll Number to update: "))
mks = float(input("Enter New Marks: "))
update_marks(r_num, mks)
